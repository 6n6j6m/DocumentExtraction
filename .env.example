# Copy to .env and fill in. Never commit .env -- it is gitignored.

# ---- Provider selection -----------------------------------------------------
# gemini | ollama
LLM_PROVIDER=gemini
# Used automatically when the primary is rate limited or unreachable. Leave empty
# to disable, so a failure is loud instead of silently answered by another model.
LLM_FALLBACK_PROVIDER=ollama

# ---- Input mode -------------------------------------------------------------
# image = render pages and send to a VLM   (better on tables, dearer, slower)
# text  = send the PDF's own text layer    (cheaper, faster, loses layout)
GEMINI_INPUT_MODE=image
OLLAMA_INPUT_MODE=image

# ---- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=120

# ---- Ollama (local) ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Must be a vision model when OLLAMA_INPUT_MODE=image (e.g. qwen3-vl:8b).
# For text mode a plain instruct model is faster (e.g. qwen2.5:7b-instruct).
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=900
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=16384

# ---- Extraction tuning ------------------------------------------------------
MAX_PDF_PAGES=20
IMAGE_DPI=150
SPLIT_BY_STATEMENT=true
CONDENSE_TEXT=true
