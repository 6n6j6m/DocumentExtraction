# Copy to .env and fill in. Never commit .env -- it is gitignored.

# ---- Provider selection -----------------------------------------------------
# gemini | ollama
LLM_PROVIDER=gemini
# Other Gemini models to try, in order, before LLM_FALLBACK_PROVIDER. Gemini counts rate
# limits per model, so each has its own RPM and RPD allowance. A throttled model hands the
# document over immediately; only the LAST Gemini model cools down before going local.
# The rotation is remembered across documents: a model resting from a 429 or a capacity
# 503 moves to the back of the queue until its cooldown ends, so later documents do not
# rediscover the same limit. Comma-separated; must be ids your key lists (a 404 prints
# them). Leave empty to go straight from GEMINI_MODEL to the local fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# Models worth waiting for before handing over: cheap and fast, where the next models in
# the chain cost more and answer slower. They cool down on a per-minute 429 and retry
# 503/500/timeouts with a growing backoff (5s, 10s, 20s ...) instead of handing over at
# once. A daily quota still hands over immediately. Worst case per call on one of these:
# RATE_LIMIT_RETRIES x LLM_RATE_LIMIT_WAIT_S of cooldown, plus RETRIES attempts that may
# each wait up to GEMINI_TIMEOUT -- keep that timeout modest.
GEMINI_PATIENT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_PATIENT_RETRIES=3
GEMINI_PATIENT_RATE_LIMIT_RETRIES=2
GEMINI_PATIENT_BACKOFF_S=5
# Used automatically when every Gemini model is rate limited or unreachable. Leave empty
# to disable, so a failure is loud instead of silently answered by another model.
LLM_FALLBACK_PROVIDER=ollama

# ---- Input mode -------------------------------------------------------------
# image = render pages and send to a VLM   (better on tables, dearer, slower)
# text  = send the PDF's own text layer    (cheaper, faster, loses layout)
GEMINI_INPUT_MODE=image
OLLAMA_INPUT_MODE=image

# ---- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=120
# A 429 means one of three Gemini limits was hit: requests per minute (RPM), tokens per
# minute (TPM) or requests per day (RPD). Per-minute limits reset on a clock, so the
# call cools down for this many seconds and retries -- slightly over a minute, because
# waiting to the exact boundary races the reset. A per-DAY quota is never waited out;
# sleeping cannot clear it. Set to 0 to fail fast on every 429.
LLM_RATE_LIMIT_WAIT_S=70
LLM_RATE_LIMIT_RETRIES=1

# ---- Ollama (local) ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Must be a vision model when OLLAMA_INPUT_MODE=image (e.g. qwen3-vl:8b).
# For text mode a plain instruct model is faster (e.g. qwen2.5:7b-instruct).
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=900
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=16384

# ---- HTTP API ---------------------------------------------------------------
API_PORT=8000
# Bounded on purpose. These calls are billed and rate limited: past a small number the
# marginal request buys a 429 rather than throughput, and a 429 costs the whole batch
# more than the parallelism saved.
API_MAX_CONCURRENCY=2
API_MAX_UPLOAD_MB=25
API_MAX_BATCH_FILES=10

# ---- Evaluation target ------------------------------------------------------
# Empty: run_eval calls extract_from_pdf in-process (the default, so the tests need no
# container). Set to an API base URL to score the SERVICE instead of the library --
# `docker compose run --rm eval` sets it to http://api:8000.
EVAL_TARGET=

# ---- Cost accounting --------------------------------------------------------
# Token prices per model. Ships EMPTY on purpose: an unpriced model reports its real
# token counts and a null cost with the reason, rather than a guessed price quoted
# with the same confidence as a measured one.
PRICING_CONFIG=config/pricing.json

# ---- Extraction tuning ------------------------------------------------------
MAX_PDF_PAGES=20
IMAGE_DPI=150
SPLIT_BY_STATEMENT=true
CONDENSE_TEXT=true
